APP_NAME=custom-data-toolkit
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
# DEBUG 会开启 SQL echo，可能把参数写入日志；默认关闭
DEBUG=false
HOST=127.0.0.1
PORT=8000
# 账号 customs_app；密码按本机修改；库名与主机与运维约定一致
DATABASE_URL=mysql+pymysql://customs_app:change-me@172.28.112.1:3306/customs_data_toolkit
TEST_DATABASE_URL=mysql+pymysql://customs_app:change-me@172.28.112.1:3306/customs_data_toolkit_test
SESSION_COOKIE_NAME=cdt_session
SESSION_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me
# 本地 Docker：主机 16379 → 容器 6379（见 docs/development.md）
REDIS_URL=redis://127.0.0.1:16379/0
# 对外 globiz 只读 API 鉴权开关（运维控制；true=必须 X-API-Key）
PUBLIC_API_AUTH_ENABLED=true
