# =============================================================================
# tendata-customs-tools — 环境变量模板（可提交仓库）
# =============================================================================
# 用法：
#   cp .env.example .env
#   再按本机/目标环境修改 .env（.env 禁止提交）
#
# 约定：
#   - 仓库只提交本文件与（可选）deploy 侧说明，不提交真实密码/Key
#   - 本地开发、UAT、生产各自维护一份运行时配置（文件或 CI 密钥注入）
#   - Python 包路径仍为 custom_data_toolkit（import/uvicorn 不变）
# =============================================================================

# --- 应用 ---
APP_NAME=tendata-customs-tools
# development | production（production 下 Session Cookie 启用 Secure）
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
DEBUG=false
HOST=127.0.0.1
PORT=8000

# --- MySQL（按环境改主机/库名/密码；勿把真实密码写回本 example）---
DATABASE_URL=mysql+pymysql://customs_app:change-me@127.0.0.1:3306/customs_data_toolkit
TEST_DATABASE_URL=mysql+pymysql://customs_app:change-me@127.0.0.1:3306/customs_data_toolkit_test

# --- Session / CORS ---
SESSION_COOKIE_NAME=cdt_session
SESSION_TTL_SECONDS=604800
# 生产改为真实前端源，多个用逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 首启管理员（仅空库种子；生产用强密码且只放运行时环境）---
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me

# --- Redis（海关字典；本地 Docker 常见映射 16379→6379，见 docs/development.md）---
REDIS_URL=redis://127.0.0.1:16379/0

# --- 对外 globiz 只读 API（运维开关；true=必须 X-API-Key）---
PUBLIC_API_AUTH_ENABLED=true
