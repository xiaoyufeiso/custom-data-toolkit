# =============================================================================
# Docker Compose 环境变量模板
# 用法：cp deploy/docker/compose.env.example deploy/docker/compose.env
#       再按目标环境修改（compose.env 勿提交）
# =============================================================================

# --- 端口（宿主机）---
BACKEND_PORT=8000
WEB_PORT=8080

# --- 后端 ---
APP_NAME=tendata-customs-tools
# 本地 http 用 development；仅 HTTPS 生产环境再用 production（Secure Cookie）
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
DEBUG=false
# 执行迁移：true（默认）| false（由外部流水线负责时）
RUN_MIGRATIONS=true

# Session / 管理员种子（生产务必改强密码）
SESSION_COOKIE_NAME=cdt_session
SESSION_TTL_SECONDS=604800
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me

# 对外 globiz 是否强制 X-API-Key
PUBLIC_API_AUTH_ENABLED=false

# --- 数据库 / Redis ---
# 默认：连外部（或宿主机）服务。Docker Desktop / 较新 Docker 可用 host.docker.internal
DATABASE_URL=mysql+pymysql://customs_app:change-me@host.docker.internal:3306/customs_data_toolkit
REDIS_URL=redis://host.docker.internal:16379/0

# 若启用 profile mysql / redis / local-deps / full，请改为服务名，例如：
# DATABASE_URL=mysql+pymysql://customs_app:change-me@mysql:3306/customs_data_toolkit
# REDIS_URL=redis://redis:6379/0

# 管理端来源（启用 profile web 时一般为 http://localhost:8080）
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# --- 可选 MySQL 容器（profile mysql | local-deps | full）---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=customs_data_toolkit
MYSQL_USER=customs_app
MYSQL_PASSWORD=change-me
