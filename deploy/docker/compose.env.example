# Compose / 编排环境变量模板。复制为 compose.env 或注入同名变量；勿提交含密钥的运行时文件。

BACKEND_PORT=8000
WEB_PORT=8080

APP_NAME=tendata-customs-tools
APP_ENV=production
APP_TIMEZONE=Asia/Shanghai
DEBUG=false

# 可选镜像构建参数
# HARBOR_REGISTRY=harbor-dev.tendata.com.cn
# PYTHON_VERSION=3.12
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

SESSION_COOKIE_NAME=cdt_session
SESSION_TTL_SECONDS=604800
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me

PUBLIC_API_AUTH_ENABLED=true

# 外部 MySQL / Redis（生产由配置中心或编排注入）
DATABASE_URL=mysql+pymysql://customs_app:change-me@mysql-host:3306/customs_data_toolkit
REDIS_URL=redis://redis-host:6379/0

# Compose 内 mysql/redis profile 时改用服务名：
# DATABASE_URL=mysql+pymysql://customs_app:change-me@mysql:3306/customs_data_toolkit
# REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=https://customs-tools.example.com

# 仅当启用 profile mysql | local-deps | full
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=customs_data_toolkit
MYSQL_USER=customs_app
MYSQL_PASSWORD=change-me
